GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=gatehouse-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
# Evidence ledger (see ledger/__init__.py). `adk deploy agent_engine` forwards this file
# to the engine, so uncomment for the deploy: the container filesystem is ephemeral and
# /tmp is always writable. Locally, leave it unset -> evidence/runs.db in the repo.
# If the path cannot be opened the ledger records in memory and warns; ids + spans still flow.
# GATEHOUSE_EVIDENCE_DB=/tmp/gatehouse-runs.db
GATEHOUSE_PROJECT=gatehouse-hackathon
